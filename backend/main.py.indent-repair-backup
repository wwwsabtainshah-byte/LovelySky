import os
import json
import base64
import sqlite3

import firebase_admin
from firebase_admin import auth, credentials
from fastapi import FastAPI, HTTPException, Header
from pydantic import BaseModel, Field

from backend.storage import setup_storage
from backend.database import get_connection, initialize_database

app = FastAPI(title="Lovely Sky API", version="1.1.0")


class GoogleLoginRequest(BaseModel):


id_token: str = Field(min_length=1)
device_id: str = Field(min_length=16, max_length=128)


def get_firebase_app():


try:
return firebase_admin.get_app()
except ValueError:
encoded = os.environ.get("FIREBASE_SERVICE_ACCOUNT_JSON_B64", "")
if not encoded:
raise HTTPException(
    status_code=503,
    detail="Firebase server configuration missing"
)

   try:
        raw = base64.b64decode(encoded, validate=True)
        service_account = json.loads(raw.decode("utf-8"))

        if service_account.get("project_id") != "lovely-sky-c9024":
            raise ValueError("Firebase project mismatch")

        return firebase_admin.initialize_app(
            credentials.Certificate(service_account),
            {"projectId": "lovely-sky-c9024"},
        )
    except Exception:
        raise HTTPException(
            status_code=503,
            detail="Firebase server configuration invalid"
        )


@app.on_event("startup")
def startup():

setup_storage()
initialize_database()


@app.get("/")
def home():

return {"app": "Lovely Sky API", "status": "online"}


@app.get("/health")
def health():

return {"status": "ok"}


@app.post("/auth/google")
def google_login(body: GoogleLoginRequest):

try:
get_firebase_app()
claims = auth.verify_id_token(body.id_token, check_revoked=True)
except HTTPException:
raise
except Exception:
raise HTTPException(status_code=401, detail="Firebase token rejected")

uid = claims.get("uid")
email = (claims.get("email") or "").strip().lower()

if not uid or not email or claims.get("email_verified") is not True:
    raise HTTPException(
        status_code=401,
        detail="Verified Google account required"
    )

try:
    with get_connection() as db:
        user = db.execute(
            "SELECT * FROM users WHERE google_uid = ?",
            (uid,),
        ).fetchone()

        email_user = db.execute(
            "SELECT * FROM users WHERE google_email = ?",
            (email,),
        ).fetchone()

        if user is None and email_user is not None:
            raise HTTPException(
                status_code=409,
                detail="This email is linked to a different account"
            )

        if user is None:
            cursor = db.execute(
                """
                INSERT INTO users (google_uid, google_email)
                VALUES (?, ?)
                """,
                (uid, email),
            )
            user_id = cursor.lastrowid
            db.execute(
                "INSERT OR IGNORE INTO wallets (user_id) VALUES (?)",
                (user_id,),
            )
        else:
            user_id = user["id"]
            db.execute(
                "UPDATE users SET google_email = ? WHERE id = ?",
                (email, user_id),
            )

        binding = db.execute(
            "SELECT user_id FROM device_bindings WHERE device_id = ?",
            (body.device_id,),
        ).fetchone()

        if binding is not None and binding["user_id"] != user_id:
            raise HTTPException(
                status_code=403,
                detail="This device is already linked to another account"
            )

        existing_binding = db.execute(
            "SELECT device_id FROM device_bindings WHERE user_id = ?",
            (user_id,),
        ).fetchone()

        if existing_binding is None:
            db.execute(
                """
                INSERT INTO device_bindings (user_id, device_id)
                VALUES (?, ?)
                """,
                (user_id, body.device_id),
            )
        elif existing_binding["device_id"] != body.device_id:
            db.execute(
                "UPDATE device_bindings SET device_id = ? WHERE user_id = ?",
                (body.device_id, user_id),
            )

        result = db.execute(
            """
            SELECT id, user_code, display_name, profile_photo
            FROM users WHERE id = ?
            """,
            (user_id,),
        ).fetchone()

    return {
        "success": True,
        "token": body.id_token,
        "user": {
            "id": result["id"],
            "user_code": result["user_code"] or str(result["id"]),
            "display_name": result["display_name"],
            "profile_photo": result["profile_photo"],
        },
    }
except HTTPException:
    raise
except sqlite3.Error:
    raise HTTPException(
        status_code=503,
        detail="Account database is temporarily unavailable"
    )


@app.get("/me")
def me(authorization: str = Header(default="")):

if not authorization.startswith("Bearer "):
raise HTTPException(status_code=401, detail="Login required")

token = authorization[7:].strip()

try:
    get_firebase_app()
    claims = auth.verify_id_token(token, check_revoked=True)
except HTTPException:
    raise
except Exception:
    raise HTTPException(status_code=401, detail="Session expired; login again")

uid = claims.get("uid")
try:
    with get_connection() as db:
        user = db.execute(
            """
            SELECT id, user_code, google_email, display_name,
                   profile_photo
            FROM users WHERE google_uid = ?
            """,
            (uid,),
        ).fetchone()

    if user is None:
        raise HTTPException(status_code=401, detail="Account not found")

    return {
        "success": True,
        "id": user["id"],
        "user_code": user["user_code"] or str(user["id"]),
        "email": user["google_email"],
        "display_name": user["display_name"],
        "profile_photo": user["profile_photo"],
    }
except HTTPException:
    raise
except sqlite3.Error:
    raise HTTPException(status_code=503, detail="Account database unavailable")
